{
  "expo": {
    "name": "CameraFocusTest",
    "slug": "CameraFocusTest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andrii.camerafocustest"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.andrii.camerafocustest"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Camera access is needed to test photo focus.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Camera access is needed to test photo focus.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Camera access is needed to test photo focus.",
          "enableMicrophonePermission": false,
          "enableFrameProcessors": false
        }
      ],
      "expo-asset"
    ]
  }
}
